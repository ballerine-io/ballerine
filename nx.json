{
  "targetDefaults": {
    "build": {
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        {
          "target": "build",
          "projects": "dependencies"
        }
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": [{ "projects": "self", "target": "build" }]
    },
    "test:unit": {
      "cache": true,
      "dependsOn": [{ "projects": "self", "target": "build" }]
    },
    "test:integration": {
      "cache": true,
      "dependsOn": [{ "projects": "self", "target": "build" }]
    },
    "test:e2e": {
      "cache": true,
      "dependsOn": [{ "projects": "self", "target": "build" }]
    },
    "lint": {
      "cache": true,
      "dependsOn": [{ "projects": "self", "target": "build" }]
    }
  },
  "defaultBase": "dev"
}
